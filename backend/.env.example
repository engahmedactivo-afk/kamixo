# Postgres connection
DATABASE_URL=postgresql://kamixo:kamixo@localhost:5432/kamixo?schema=public

PORT=3000
# Long random string used to sign user access tokens
JWT_SECRET=change-me-to-a-long-random-string
# Sent as the "x-admin-key" header by the admin CMS
ADMIN_API_KEY=change-me-admin-key

# Purchase verification: "sandbox" (dev only, accepts any receipt) or "revenuecat"
PURCHASE_VERIFIER=sandbox
REVENUECAT_SECRET_API_KEY=

# Playback URL signing (token-auth compatible with a CDN edge rule; leave empty to return raw URLs in dev)
PLAYBACK_SIGNING_SECRET=
PLAYBACK_URL_TTL_SECONDS=3600

# ---- Phase 2 ----
# RevenueCat webhook: set the same value as "Authorization header" in the RevenueCat dashboard
REVENUECAT_WEBHOOK_SECRET=

# Rewarded ads: "sandbox" (dev: the app's word is trusted) or "admob" (AdMob server-side verification callback)
AD_REWARD_VERIFIER=sandbox
# Max episodes a user can unlock by watching ads per UTC day
AD_UNLOCK_DAILY_CAP=5

# Push notifications (FCM HTTP v1). Paste the whole Firebase service-account JSON on one line; empty disables push.
FCM_SERVICE_ACCOUNT_JSON=

# Public base URL of this API (used for share / deep-link landing pages)
PUBLIC_BASE_URL=http://localhost:3000
# Custom URL scheme the mobile app registers for deep links
APP_URL_SCHEME=kamixo
